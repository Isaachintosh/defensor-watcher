    "mobility_needs": {
      "type": "array",
      "required": false
    },
    "accessibility_needs": {
      "type": "array",
      "required": false
    },
    "transport_capabilities": {
      "type": "array",
      "required": false
    },
    "meeting_points": {
      "type": "array",
      "required": false
    },
    "essential_contacts": {
      "type": "array",
      "required": false
    },
    "essential_dependencies": {
      "type": "array",
      "required": false
    },
    "offline_storage_consent": {
      "type": "boolean",
      "required": false
    }
  },
  "controls": [
